@@ -0,0 +1,137 @@
+#!/usr/bin/env python3
+"""Verify a real onboard camera -> H264 -> 0310 -> PTY, without extra Python packages."""
+import argparse
+from datetime import datetime
+import json
+import os
+from pathlib import Path
+import pty
+import re
+import select
+import signal
+import subprocess
+import time
+import tty
+
+
+def crc(data, initial, poly, width):
+    value = initial
+    for byte in data:
+        value ^= byte
+        for _ in range(8):
+            value = (value >> 1) ^ (poly if value & 1 else 0)
+    return value & ((1 << width) - 1)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--duration', type=float, default=15)
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parents[1]
+    output = root / 'logs' / ('camera-smoke-' + datetime.now().strftime('%Y%m%d-%H%M%S'))
+    output.mkdir(parents=True)
+    master, slave = pty.openpty()
+    tty.setraw(slave)
+    stats = dict(packets=0, crc8_errors=0, crc16_errors=0, invalid_length=0,
+                 sequence_gaps=0, h264_bytes=0)
+    last_sequence = None
+    buffer = bytearray()
+    captured = bytearray()
+    command = [str(root / 'scripts/run-onboard.sh'), '--video-serial', os.ttyname(slave)]
+    log = (output / 'bridge.log').open('w')
+    proc = subprocess.Popen(command, stdout=log, stderr=subprocess.STDOUT, cwd=root)
+    try:
+        deadline = time.monotonic() + args.duration
+        with (output / 'serial.bin').open('wb') as raw:
+            while time.monotonic() < deadline:
+                if proc.poll() is not None:
+                    break
+                ready, _, _ = select.select([master], [], [], 0.2)
+                if not ready:
+                    continue
+                data = os.read(master, 65536)
+                raw.write(data)
+                buffer.extend(data)
+                while len(buffer) >= 5:
+                    if buffer[0] != 0xA5:
+                        del buffer[0]
+                        continue
+                    if crc(buffer[:4], 0xFF, 0x8C, 8) != buffer[4]:
+                        stats['crc8_errors'] += 1
+                        del buffer[0]
+                        continue
+                    size = int.from_bytes(buffer[1:3], 'little')
+                    if size > 300:
+                        stats['invalid_length'] += 1
+                        del buffer[0]
+                        continue
+                    total = size + 9
+                    if len(buffer) < total:
+                        break
+                    frame = bytes(buffer[:total])
+                    del buffer[:total]
+                    if crc(frame[:-2], 0xFFFF, 0x8408, 16) != int.from_bytes(frame[-2:], 'little'):
+                        stats['crc16_errors'] += 1
+                        continue
+                    if frame[5:7] != b'\x10\x03':
+                        continue
+                    if size != 300:
+                        stats['invalid_length'] += 1
+                        continue
+                    block = frame[7:-2]
+                    count = block[2] | ((block[0] & 2) << 7)
+                    if count > 297 or block[0] & 0xFC:
+                        stats['invalid_length'] += 1
+                        continue
+                    if last_sequence is not None and block[1] != (last_sequence + 1) % 256:
+                        stats['sequence_gaps'] += 1
+                    last_sequence = block[1]
+                    stats['packets'] += 1
+                    stats['h264_bytes'] += count
+                    captured.extend(block[3:3 + count])
+    finally:
+        proc.send_signal(signal.SIGTERM) if proc.poll() is None else None
+        try:
+            proc.wait(timeout=8)
+        except subprocess.TimeoutExpired:
+            proc.kill()
+            proc.wait()
+        log.close()
+        os.close(master)
+        os.close(slave)
+    (output / 'received.h264').write_bytes(captured)
+    # A timed serial capture can stop halfway through a slice. Validate only
+    # completed GOPs, keeping the original capture above as evidence.
+    sps_offsets = [match.start() for match in re.finditer(b'\x00\x00(?:\x00)?\x01', captured)
+                   if match.end() < len(captured) and captured[match.end()] & 31 == 7]
+    complete = captured[:sps_offsets[-1]] if len(sps_offsets) > 1 else captured
+    (output / 'complete-gops.h264').write_bytes(complete)
+    stats['complete_gop_bytes'] = len(complete)
+    decoded = subprocess.run(['ffmpeg', '-hide_banner', '-loglevel', 'warning',
+                              '-r', '15', '-f', 'h264', '-i', str(output / 'complete-gops.h264'),
+                              '-f', 'null', '-'], capture_output=True, text=True)
+    (output / 'decoder.log').write_text(decoded.stderr)
+    probe = subprocess.run(['ffprobe', '-v', 'error', '-count_frames', '-select_streams', 'v:0',
+                            '-show_entries', 'stream=codec_name,width,height,nb_read_frames',
+                            '-of', 'json', str(output / 'complete-gops.h264')], capture_output=True, text=True)
+    # Jetson multimedia libraries sometimes print an EGL notice to stdout.
+    json_start = probe.stdout.find('{')
+    stats['stream'] = json.loads(probe.stdout[json_start:]) if json_start >= 0 else {}
+    subprocess.run(['ffmpeg', '-y', '-hide_banner', '-loglevel', 'error', '-f', 'h264',
+                    '-i', str(output / 'complete-gops.h264'), '-frames:v', '1',
+                    str(output / 'decoded.png')], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    stats['bridge_returncode'] = proc.returncode
+    stats['decoder_returncode'] = decoded.returncode
+    streams = stats['stream'].get('streams', [])
+    stats['passed'] = (stats['packets'] > 100 and not any(stats[key] for key in
+                       ['crc8_errors', 'crc16_errors', 'invalid_length', 'sequence_gaps'])
+                       and bool(streams) and int(streams[0].get('nb_read_frames', '0')) > 10
+                       and decoded.returncode == 0 and proc.returncode == 0)
+    (output / 'summary.json').write_text(json.dumps(stats, indent=2) + '\n')
+    print(json.dumps(stats, indent=2))
+    print('OUTPUT=' + str(output))
+    return 0 if stats['passed'] else 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
