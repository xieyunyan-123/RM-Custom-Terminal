+[Unit]
+Description=Hik camera H264 and RoboMaster 0310 serial bridge
+
+[Service]
+Type=simple
+User=robot
+Group=robot
+WorkingDirectory=/opt/rm-hik-bridge
+ExecStart=/opt/rm-hik-bridge/scripts/run-onboard.sh --video-serial /dev/ttyUSB0
+Restart=on-failure
+RestartSec=2
+KillMode=mixed
+TimeoutStopSec=10
+StandardOutput=append:/opt/rm-hik-bridge/logs/live-serial.log
+StandardError=inherit
+
+[Install]
+WantedBy=multi-user.target
