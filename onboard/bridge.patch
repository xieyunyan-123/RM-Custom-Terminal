diff --git a/tools/capture_hik_frame.cpp b/tools/capture_hik_frame.cpp
new file mode 100644
index 0000000..fe65e6a
--- /dev/null
+++ b/tools/capture_hik_frame.cpp
@@ -0,0 +1,43 @@
+#include "bridge/hik_camera.hpp"
+#include "bridge/options.hpp"
+#include <opencv2/imgcodecs.hpp>
+#include <opencv2/imgproc.hpp>
+#include <chrono>
+#include <filesystem>
+#include <iostream>
+
+int main(int argc, char **argv)
+{
+  if (argc < 2) {
+    std::cerr << "Usage: capture_hik_frame OUTPUT.png [--config PATH] [--camera-serial SERIAL]"
+                 " [--exposure-ms MS] [--gain GAIN]\n";
+    return 2;
+  }
+  try {
+    const std::filesystem::path output(argv[1]);
+    const auto options = bridge::parse_args(argc - 1, argv + 1);
+    bridge::HikCamera camera;
+    camera.open_first(options.exposure_ms, options.gain, options.camera_serial_number);
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+    bridge::FrameInfo frame;
+    while (std::chrono::steady_clock::now() < deadline) {
+      const auto result = camera.grab(frame, 200, true);
+      if (result == bridge::CameraGrabResult::DeviceError) {
+        throw std::runtime_error(camera.last_error());
+      }
+      if (result != bridge::CameraGrabResult::Success) continue;
+      cv::Mat rgb(frame.height, frame.width, CV_8UC3, frame.rgb24.data());
+      cv::Mat bgr;
+      cv::cvtColor(rgb, bgr, cv::COLOR_RGB2BGR);
+      if (output.has_parent_path()) std::filesystem::create_directories(output.parent_path());
+      if (!cv::imwrite(output.string(), bgr)) throw std::runtime_error("image write failed");
+      std::cout << "Saved " << output << " " << frame.width << 'x' << frame.height
+                << " frame=" << frame.sequence << '\n';
+      return 0;
+    }
+    throw std::runtime_error("camera frame timeout");
+  } catch (const std::exception &error) {
+    std::cerr << error.what() << '\n';
+    return 1;
+  }
+}
