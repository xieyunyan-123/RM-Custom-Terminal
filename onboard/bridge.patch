+#!/usr/bin/env bash
+set -euo pipefail
+SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
+PROJECT_DIR=$(cd -- "$SCRIPT_DIR/.." && pwd)
+export SYSTEM_MVS_RUNTIME_PATH="${SYSTEM_MVS_RUNTIME_PATH:-/opt/MVS/lib/aarch64}"
+case "${RM_BRIDGE_VIEW:-full}" in
+  full) view_args=(--full-view) ;;
+  detail) view_args=(--crop-size 800) ;;
+  wide) view_args=(--crop-size 0) ;;
+  *) printf "RM_BRIDGE_VIEW must be full, detail, or wide\n" >&2; exit 2 ;;
+esac
+exec "$SCRIPT_DIR/run-bridge.sh" \
+  --config "$PROJECT_DIR/config/bridge.onboard.yaml" \
+  --video-size 360 --video-fps 8 --video-bitrate-kbps 80 --video-gop 8 --send-interval-ms 20 \
+  "${view_args[@]}" --video-denoise "${RM_BRIDGE_DENOISE:-light}" --static-simplify --motion-threshold 14 --motion-erode-px 2 --motion-dilate-px 6 --bg-blur-sigma 1.5 --lift-shadows "$@"
