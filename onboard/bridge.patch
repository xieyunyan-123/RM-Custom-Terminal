+#!/usr/bin/env python3
+"""Send to a real serial port while decoding an identical local UDP mirror.
+
+This proves host serial writes and local encoding, not receipt by the radio or client.
+"""
+import argparse
+from datetime import datetime
+import json
+from pathlib import Path
+import re
+import signal
+import socket
+import subprocess
+import time
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument('--serial', required=True)
+    p.add_argument('--duration', type=float, default=20)
+    p.add_argument('--port', type=int, default=3335)
+    args = p.parse_args()
+    root = Path(__file__).resolve().parents[1]
+    output = root / 'logs' / ('serial-send-' + datetime.now().strftime('%Y%m%d-%H%M%S'))
+    output.mkdir(parents=True)
+    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+    sock.bind(('127.0.0.1', args.port))
+    sock.settimeout(0.2)
+    log = (output / 'bridge.log').open('w')
+    proc = subprocess.Popen([str(root / 'scripts/run-onboard.sh'),
+                             '--video-serial', args.serial, '--viewer-ip', '127.0.0.1',
+                             '--viewer-port', str(args.port)], cwd=root,
+                            stdout=log, stderr=subprocess.STDOUT)
+    stats = dict(serial=args.serial, mirror_packets=0, invalid=0, sequence_gaps=0)
+    captured = bytearray()
+    last = None
+
+    def consume(block):
+        nonlocal last
+        if len(block) != 300 or block[0] & 0xFC:
+            stats['invalid'] += 1
+            return
+        count = block[2] | ((block[0] & 2) << 7)
+        if count > 297:
+            stats['invalid'] += 1
+            return
+        if last is not None and block[1] != (last + 1) % 256:
+            stats['sequence_gaps'] += 1
+        last = block[1]
+        stats['mirror_packets'] += 1
+        captured.extend(block[3:3 + count])
+
+    try:
+        deadline = time.monotonic() + args.duration
+        while time.monotonic() < deadline and proc.poll() is None:
+            try:
+                consume(sock.recv(4096))
+            except socket.timeout:
+                pass
+    finally:
+        if proc.poll() is None:
+            proc.send_signal(signal.SIGTERM)
+        try:
+            proc.wait(timeout=8)
+        except subprocess.TimeoutExpired:
+            proc.kill()
+            proc.wait()
+        while True:
+            try:
+                consume(sock.recv(4096))
+            except socket.timeout:
+                break
+        sock.close()
+        log.close()
+    text = (output / 'bridge.log').read_text()
+    counts = re.findall(r'stopped sent=(\d+) serial_written=(\d+) serial_errors=(\d+)', text)
+    stats['sender_final'] = dict(zip(['sent', 'serial_written', 'serial_errors'], map(int, counts[-1]))) if counts else {}
+    (output / 'mirror.h264').write_bytes(captured)
+    sps = [m.start() for m in re.finditer(b'\x00\x00(?:\x00)?\x01', captured)
+           if m.end() < len(captured) and captured[m.end()] & 31 == 7]
+    complete = captured[:sps[-1]] if len(sps) > 1 else captured
+    stream = output / 'complete-gops.h264'
+    stream.write_bytes(complete)
+    decoded = subprocess.run(['ffmpeg', '-hide_banner', '-loglevel', 'warning', '-r', '15',
+                              '-f', 'h264', '-i', str(stream), '-f', 'null', '-'],
+                             capture_output=True, text=True)
+    (output / 'decoder.log').write_text(decoded.stderr)
+    probe = subprocess.run(['ffprobe', '-v', 'error', '-count_frames', '-select_streams', 'v:0',
+                            '-show_entries', 'stream=codec_name,width,height,nb_read_frames',
+                            '-of', 'json', str(stream)], capture_output=True, text=True)
+    start = probe.stdout.find('{')
+    stats['stream'] = json.loads(probe.stdout[start:]) if start >= 0 else {}
+    subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-i', str(stream), '-frames:v', '1',
+                    str(output / 'decoded.png')], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    stats['bridge_returncode'] = proc.returncode
+    stats['decoder_returncode'] = decoded.returncode
+    stats['h264_bytes'] = len(captured)
+    final = stats['sender_final']
+    streams = stats['stream'].get('streams', [])
+    stats['passed'] = (final.get('serial_written', 0) == stats['mirror_packets'] > 100
+                       and final.get('serial_errors', -1) == stats['invalid'] == stats['sequence_gaps'] == 0
+                       and decoded.returncode == proc.returncode == 0 and bool(streams)
+                       and int(streams[0].get('nb_read_frames', '0')) > 10)
+    stats['scope'] = 'Host serial writes and local mirrored stream only; no remote acknowledgement.'
+    (output / 'summary.json').write_text(json.dumps(stats, indent=2) + '\n')
+    print(json.dumps(stats, indent=2))
+    print('OUTPUT=' + str(output))
+    return 0 if stats['passed'] else 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
